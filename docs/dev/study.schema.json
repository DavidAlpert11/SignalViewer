{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/DavidAlpert11/SignalViewer/docs/dev/study.schema.json",
 "title": "Signal Viewer study (.svstudy.json), version 1",
 "description": "One parameter set for many systems (W14), next runs (W15), the launcher (W17), the demo (W18). Unknown keys are kept on load and written back; missing keys take their defaults (svcore/study.py).",
 "type": "object",
 "properties": {
  "version": {
   "const": 1
  },
  "name": {
   "type": "string"
  },
  "tables": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "paths": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "rename": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "this table's column -> the common name"
     },
     "roles": {
      "type": "object",
      "additionalProperties": {
       "enum": [
        "shared",
        "scenario",
        "local",
        "output",
        "ignore"
       ]
      }
     },
     "drop": {
      "type": "object",
      "additionalProperties": {
       "type": "array"
      },
      "description": "scenario column -> values left out"
     },
     "constraints": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "objective": {
      "type": "object",
      "properties": {
       "expr": {
        "type": "string"
       },
       "sense": {
        "enum": [
         "min",
         "max"
        ]
       }
      },
      "required": [],
      "additionalProperties": true
     },
     "aggregate": {
      "enum": [
       "worst",
       "mean"
      ]
     },
     "sim_exe": {
      "type": "string"
     },
     "params_template": {
      "type": "string"
     },
     "params_template_file": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "paths"
    ],
    "additionalProperties": true
   }
  },
  "shared": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "tolerance": {
      "type": "number",
      "minimum": 0
     }
    },
    "required": [
     "name"
    ],
    "additionalProperties": true
   }
  },
  "combine": {
   "type": "object",
   "properties": {
    "mode": {
     "enum": [
      "auto",
      "minworst",
      "pareto"
     ]
    },
    "weights": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    }
   },
   "required": [],
   "additionalProperties": true
  },
  "search": {
   "type": "object",
   "properties": {
    "params": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "min": {
        "type": [
         "number",
         "null"
        ]
       },
       "max": {
        "type": [
         "number",
         "null"
        ]
       },
       "step": {
        "type": [
         "number",
         "null"
        ]
       },
       "values": {
        "type": [
         "array",
         "null"
        ],
        "items": {
         "type": "number"
        }
       },
       "integer": {
        "type": "boolean"
       },
       "log": {
        "type": "boolean"
       }
      },
      "required": [],
      "additionalProperties": true
     }
    },
    "constraints": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [],
   "additionalProperties": true
  },
  "next": {
   "type": "object",
   "properties": {
    "batch": {
     "type": "integer",
     "minimum": 1,
     "description": "candidate values of S per round; each expands to its runs in every table"
    },
    "mix": {
     "type": "object",
     "properties": {
      "refine": {
       "type": "number"
      },
      "boundary": {
       "type": "number"
      },
      "gap": {
       "type": "number"
      }
     },
     "required": [],
     "additionalProperties": true
    },
    "folder": {
     "type": "string"
    },
    "columns": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     }
    },
    "format": {
     "enum": [
      "csv",
      "xlsx"
     ]
    }
   },
   "required": [],
   "additionalProperties": true
  },
  "launcher": {
   "type": "object",
   "properties": {
    "params_template": {
     "type": "string"
    },
    "params_template_file": {
     "type": "string"
    },
    "params_name": {
     "type": "string"
    },
    "submit": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "submit_mode": {
     "enum": [
      "round",
      "run"
     ]
    },
    "sim_exe": {
     "type": "string"
    },
    "results": {
     "type": "object",
     "properties": {
      "glob": {
       "type": "string"
      },
      "format": {
       "enum": [
        "csv_row",
        "csv_series",
        "json",
        "loader"
       ]
      },
      "reduce": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      },
      "json_keys": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      },
      "converter": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [],
     "additionalProperties": true
    },
    "status": {
     "type": "object",
     "properties": {
      "failed_glob": {
       "type": "string"
      },
      "timeout_s": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [],
     "additionalProperties": true
    },
    "local_workers": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    }
   },
   "required": [],
   "additionalProperties": true
  },
  "demo": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "sleep_ms": {
     "type": "integer",
     "minimum": 0
    },
    "noise": {
     "type": "number",
     "minimum": 0
    },
    "seed": {
     "type": "integer"
    },
    "tolerance_pct": {
     "type": "number",
     "minimum": 0
    },
    "max_rounds": {
     "type": "integer",
     "minimum": 1
    },
    "reference": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "history": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "round": {
      "type": "integer"
     },
     "date": {
      "type": "string"
     },
     "folder": {
      "type": "string"
     },
     "proposals": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "run_id": {
         "type": "string"
        },
        "table": {
         "type": "string"
        },
        "values": {
         "type": "object"
        },
        "reason": {
         "enum": [
          "refine",
          "boundary",
          "gap",
          "start"
         ]
        },
        "state": {
         "enum": [
          "pending",
          "submitted",
          "done",
          "failed",
          "partly done"
         ]
        }
       },
       "required": [
        "run_id",
        "table"
       ],
       "additionalProperties": true
      }
     }
    },
    "required": [],
    "additionalProperties": true
   }
  }
 },
 "required": [
  "version",
  "tables"
 ],
 "additionalProperties": true
}